
enum ThemeMode {
  light
  dark
  primitive
}

enum StyleType {
  color
  spatial
  size // specific size - eg 2px OR 4rem (a single unit of measure)
  dimension // one of more sizes - eg "2em 4em" or "1px 1px 2px 4px"
  font
  shadow
  zindex
  gradient
  weight
  css
}

enum TokenType {
  semantic
  applied
  primitive
}

enum Priority {
  LOW
  NORMAL
  HIGH
  ESSENTIAL
}