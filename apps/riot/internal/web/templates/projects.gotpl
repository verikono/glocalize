<aside id="projects-list" class="projects-list">
    <input id="projects-search" class="projects-search" type="search" placeholder="search projects" title="prefix with ! to exclude" spellcheck="false" aria-label="search projects" />
    <div id="projects-items" class="projects-items" aria-label="projects"></div>
</aside>
<div id="projects-resizer" class="projects-resizer" role="separator" aria-orientation="vertical" aria-label="resize project list" tabindex="0"></div>
<section id="projects-main" class="projects-main">
    <h1 id="project-name" class="project-name"></h1>
    <form id="project-form" class="skill-form" autocomplete="off" novalidate>
        <div id="project-form-title" class="skill-title"></div>
        <div class="skill-row">
            <label class="skill-field-group">
                <span class="skill-label">name</span>
                <input id="project-form-name" class="skill-field" type="text" placeholder="name" spellcheck="false" />
            </label>
            <label class="skill-field-group">
                <span class="skill-label">location</span>
                <input id="project-form-location" class="skill-field" type="text" placeholder="absolute path to the repo root, or N/A" spellcheck="false" />
            </label>
        </div>
        <div class="skill-row">
            <label class="skill-field-group">
                <span class="skill-label">skills path</span>
                <input id="project-form-skills-path" class="skill-field" type="text" placeholder="skills path" spellcheck="false" />
            </label>
            <label class="skill-field-group">
                <span class="skill-label">agents path</span>
                <input id="project-form-agents-path" class="skill-field" type="text" placeholder="agents path" spellcheck="false" />
            </label>
        </div>
        <div class="skill-row skill-actions">
            <span id="project-form-status" class="skill-status" role="status"></span>
            <button type="button" id="project-form-new" class="skill-button skill-create" title="start a new project" aria-label="start a new project">New</button>
            <button type="button" id="project-form-revert" class="skill-button">Revert</button>
            <button type="submit" id="project-form-save" class="skill-button skill-save">Save</button>
        </div>
    </form>
    <div id="project-tree" class="project-tree"></div>
</section>
